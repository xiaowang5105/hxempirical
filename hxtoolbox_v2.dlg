PROGRAM render_schema
BEGIN
    call dialog_ready.setvalue "0"
    call program hide_pages
    put "hxpick, target(all) action(clear)"
    stata hidden immediate
    call current_cmd.setvalue char _dta[hxtoolbox_resolve_name]
    call schema_dep.setvalue char _dta[hxtoolbox_schema_has_depvar]
    call schema_vars.setvalue char _dta[hxtoolbox_schema_has_varlist]
    call schema_if.setvalue char _dta[hxtoolbox_schema_has_if]
    call schema_in.setvalue char _dta[hxtoolbox_schema_has_in]
    call schema_weight.setvalue char _dta[hxtoolbox_schema_has_weight]
    call schema_using.setvalue char _dta[hxtoolbox_schema_has_using]
    call schema_newvar.setvalue char _dta[hxtoolbox_schema_has_newvar]
    call schema_expression.setvalue char _dta[hxtoolbox_schema_has_expression]
    call schema_absorb.setvalue char _dta[hxtoolbox_schema_has_absorb]
    call schema_vce.setvalue char _dta[hxtoolbox_schema_has_vce]
    call schema_cluster.setvalue char _dta[hxtoolbox_schema_has_cluster]
    call schema_iv.setvalue char _dta[hxtoolbox_schema_has_iv]
    call schema_panel.setvalue char _dta[hxtoolbox_schema_needs_panel]
    call schema_model_before.setvalue char _dta[hxtoolbox_schema_model_before]
    call schema_models.setvalue char _dta[hxtoolbox_schema_models]
    call schema_template.setvalue char _dta[hxtoolbox_schema_template]
    call schema_show_advanced.setvalue char _dta[hxtoolbox_sem_show_advanced]
    call schema_show_merge_check.setvalue char _dta[hxtoolbox_sem_show_merge_check]
    call schema_is_xtset.setvalue char _dta[hxtoolbox_sem_is_xtset]
    call schema_keepdrop_mode.setvalue char _dta[hxtoolbox_sem_keepdrop_mode]
    call schema_winsor_mode.setvalue char _dta[hxtoolbox_sem_winsor_mode]
    call schema_predict_mode.setvalue char _dta[hxtoolbox_sem_predict_mode]

    call main.tx_cmd_title.setlabel char _dta[hxtoolbox_sem_title]
    call main.tx_quality.setlabel char _dta[hxtoolbox_resolve_quality]
    call main.tx_installed.setlabel char _dta[hxtoolbox_sem_purpose1]
    call main.tx_help.setlabel char _dta[hxtoolbox_sem_purpose2]
    call main.tx_source.setlabel char _dta[hxtoolbox_resolve_installed]
    call main.tx_dep.setlabel char _dta[hxtoolbox_sem_dep_label]
    call main.tx_vars.setlabel char _dta[hxtoolbox_sem_vars_label]
    call main.tx_newvar.setlabel char _dta[hxtoolbox_sem_newvar_label]
    call main.tx_expression.setlabel char _dta[hxtoolbox_sem_expr_label]
    call main.tx_model.setlabel char _dta[hxtoolbox_sem_model_label]
    call main.tx_absorb.setlabel char _dta[hxtoolbox_sem_absorb_label]
    call main.tx_endog.setlabel char _dta[hxtoolbox_sem_endog_label]
    call main.tx_inst.setlabel char _dta[hxtoolbox_sem_inst_label]
    call main.tx_using.setlabel char _dta[hxtoolbox_sem_using_label]
    call main.tx_if.setlabel char _dta[hxtoolbox_sem_if_label]
    call main.tx_example_code1.setlabel char _dta[hxtoolbox_sem_example1]
    call main.tx_example_explain1.setlabel char _dta[hxtoolbox_sem_explain1]
    call main.tx_example_code2.setlabel char _dta[hxtoolbox_sem_example2]
    call main.tx_example_explain2.setlabel char _dta[hxtoolbox_sem_explain2]
    call main.tx_panel_status_main.setlabel char _dta[hxtoolbox_panel_status]

    call main.cb_model.repopulate
    call main.ed_newvar.setvalue ""
    call main.ed_expression.setvalue char _dta[hxtoolbox_sem_default_expression]
    call main.ed_vars.setvalue ""
    call main.ed_absorb.setvalue ""
    call main.ed_endog.setvalue ""
    call main.ed_inst.setvalue ""
    call main.ed_vars_value.setvalue ""
    call main.ed_absorb_value.setvalue ""
    call main.ed_endog_value.setvalue ""
    call main.ed_inst_value.setvalue ""
    call selected_vars.setvalue ""
    call selected_absorb.setvalue ""
    call selected_endog.setvalue ""
    call selected_inst.setvalue ""
    call main.ed_if.setvalue ""
    call main.ck_condition.setoff
    call main.ed_cond_value.setvalue ""
    call main.ed_in.setvalue ""
    call main.ed_special.setvalue ""
    call main.ed_options.setvalue ""
    call main.fi_using.setvalue ""
    if schema_models {
        call main.cb_model.setvalue char _dta[hxtoolbox_schema_default_model]
    }
    if schema_vce.iseq("1") {
        call main.cb_vce.setvalue "default"
    }

    call main.gb_schema.show
    call main.tx_cmd_title.show
    call main.tx_quality.show
    call main.tx_installed.show
    call main.tx_help.show
    call main.tx_source.show
    call main.bu_example.show
    call main.bu_help.show
    call main.bu_official.show
    call main.bu_schema_refresh.show
    call main.bu_add_favorite.show
    call program show_param_controls
    call dialog_ready.setvalue "1"
    call program preview_schema
END

