        put ")"
        stata hidden immediate
        call main.tx_pipeline1.setlabel char _dta[hxtoolbox_insight_intent]
        call main.tx_pipeline_data.setlabel char _dta[hxtoolbox_insight_data]
        call main.tx_pipeline2.setlabel char _dta[hxtoolbox_insight_advantages]
        call main.tx_pipeline3.setlabel char _dta[hxtoolbox_insight_limitations]
    }
END

