PROGRAM show_param_controls
BEGIN
    call program hide_advanced_page
    call program hide_examples_page
    call program hide_param_controls
    call main.gb_params.show
    if schema_newvar.iseq("1") {
        call main.tx_newvar.show
        call main.ed_newvar.show
    }
    if schema_dep.iseq("1") {
        call main.tx_dep.show
        call main.cb_dep.show
    }
    if schema_models {
        call main.tx_model.show
        call main.cb_model.show
    }
    if schema_vars.iseq("1") {
        call main.tx_vars.show
        call main.cb_var_pick.show
        call main.bu_var_add.show
        call main.ed_vars.show
        call main.bu_var_clear.show
    }
    if schema_template.iseq("generic") & schema_dep.iseq("0") & schema_vars.iseq("0") & schema_expression.iseq("0") {
        call main.tx_vars.setlabel "能够确认的变量（可选）"
        call main.tx_vars.show
        call main.cb_var_pick.show
        call main.bu_var_add.show
        call main.ed_vars.show
        call main.bu_var_clear.show
    }
    if schema_panel.iseq("1") {
        call main.tx_panel.show
        call main.cb_panel.show
        if schema_template.iseq("collapse") {
            call main.cb_time.hide
            call main.bu_xtset.hide
            call main.tx_panel_status_main.hide
        }
        else if schema_template.iseq("reshape") {
            call main.cb_time.show
            call main.bu_xtset.hide
            call main.tx_panel_status_main.hide
        }
        else {
            call main.cb_time.show
            call main.bu_xtset.show
            call main.tx_panel_status_main.show
        }
    }
    if schema_using.iseq("1") {
        call main.tx_using.show
        call main.fi_using.show
    }
    if schema_expression.iseq("1") {
        call main.tx_expression.show
        call main.ed_expression.show
    }
    if schema_iv.iseq("1") {
        call main.tx_endog.show
        call main.cb_endog_pick.show
        call main.bu_endog_add.show
        call main.ed_endog.show
        call main.bu_endog_clear.show
        call main.tx_inst.show
        call main.cb_inst_pick.show
        call main.bu_inst_add.show
        call main.ed_inst.show
        call main.bu_inst_clear.show
    }
    if schema_absorb.iseq("1") {
        call main.tx_absorb.show
        call main.cb_absorb_pick.show
        call main.bu_absorb_add.show
        call main.ed_absorb.show
        call main.bu_absorb_clear.show
    }
    if schema_vce.iseq("1") {
        call main.tx_vce.show
        call main.cb_vce.show
    }
    if schema_if.iseq("1") {
        if schema_template.iseq("replace") {
            call main.ck_condition.show
            call program condition_changed
        }
        else {
            call main.tx_if.show
            call main.ed_if.show
        }
    }
    if schema_show_advanced.iseq("1") {
        call main.bu_more.show
    }
    if schema_show_merge_check.iseq("1") {
        call main.bu_merge_check.show
    }
    if schema_keepdrop_mode.iseq("1") {
        call program model_changed
    }
    if schema_template.iseq("ttest") {
        call program model_changed
    }
END

PROGRAM condition_changed
BEGIN
    if main.ck_condition {
        call main.cb_cond_var.show
        call main.cb_cond_op.show
        call main.ed_cond_value.show
    }
    else {
        call main.cb_cond_var.hide
        call main.cb_cond_op.hide
        call main.ed_cond_value.hide
    }
    call program preview_schema
END

PROGRAM show_advanced
BEGIN
    call program hide_param_controls
    call program hide_examples_page
    call main.gb_advanced.show
    call main.tx_advanced_tip.show
    if schema_weight.iseq("1") {
        call main.tx_weight.show
        call main.cb_weight.show
        call main.cb_weight_var.show
    }
    if schema_in.iseq("1") {
        call main.tx_in.show
        call main.ed_in.show
    }
    call main.tx_special.show
    call main.ed_special.show
    call main.tx_options.show
    call main.ed_options.show
    call main.tx_advanced_note.show
    call main.bu_advanced_back.show
END

PROGRAM show_examples
BEGIN
    call program hide_param_controls
    call program hide_advanced_page
    call main.gb_examples.show
    call main.tx_example_code1.show
    call main.tx_example_explain1.show
    call main.tx_example_code2.show
    call main.tx_example_explain2.show
    call main.tx_example_note.show
    call main.bu_example_back.show
END

PROGRAM back_to_params
BEGIN
    call program show_param_controls
END

PROGRAM vce_changed
BEGIN
    if main.cb_vce.iseq("cluster") {
        call main.tx_cluster.show
        call main.cb_cluster.show
    }
    else {
        call main.tx_cluster.hide
        call main.cb_cluster.hide
    }
    call program preview_schema
END

PROGRAM model_changed
BEGIN
    if schema_keepdrop_mode.iseq("1") {
        if main.cb_model.iseq("处理变量") {
            call main.tx_vars.show
            call main.cb_var_pick.show
            call main.bu_var_add.show
            call main.ed_vars.show
            call main.bu_var_clear.show
            call main.tx_if.hide
            call main.ed_if.hide
        }
        else {
            call main.tx_vars.hide
            call main.cb_var_pick.hide
            call main.bu_var_add.hide
            call main.ed_vars.hide
            call main.bu_var_clear.hide
            call main.tx_if.show
            call main.ed_if.show
        }
    }
    if schema_template.iseq("ttest") {
        if main.cb_model.iseq("分组比较") {
            call main.tx_expression.setlabel "分组变量（如 firm）"
        }
        else if main.cb_model.iseq("配对比较") {
            call main.tx_expression.setlabel "第二变量（如 x）"
        }
        else {
            call main.tx_expression.setlabel "比较数值（如 0）"
        }
    }
    if schema_template.iseq("conversion") {
        if main.cb_model.iseq("覆盖原变量") {
            call main.tx_newvar.hide
            call main.ed_newvar.hide
        }
        else {
            call main.tx_newvar.show
            call main.ed_newvar.show
        }
    }
    call program preview_schema
END

PROGRAM preview_schema_minimal
BEGIN
    put "hxpreview"
    stata hidden immediate
    call main.ed_preview.setvalue char _dta[hxtoolbox_preview]
END

PROGRAM preview_schema
BEGIN
    if dialog_ready.iseq("1") {
    put "hxpreview, depvar(" `"""'
    put main.cb_dep
    put `"""' ") newvar(" `"""'
    put main.ed_newvar
    put `"""' ") model(" `"""'
    put main.cb_model
    put `"""' ") expression(" `"""'
    put main.ed_expression
    put `"""' ") usingfile(" `"""'
    put main.fi_using
    put `"""' ") panel(" `"""'
    put main.cb_panel
    put `"""' ") time(" `"""'
    put main.cb_time
    put `"""' ") vce(" `"""'
    put main.cb_vce
    put `"""' ") cluster(" `"""'
    put main.cb_cluster
    put `"""' ") ifcond(" `"""'
    put main.ed_if
    put `"""' ") incond(" `"""'
    put main.ed_in
    put `"""' ") special(" `"""'
    put main.ed_special
    put `"""' ") options(" `"""'
    put main.ed_options
    put `"""' ") weight(" `"""'
    put main.cb_weight
    put `"""' ") weightvar(" `"""'
    put main.cb_weight_var
    put `"""' ") condvar(" `"""'
    put main.cb_cond_var
    put `"""' ") condop(" `"""'
    put main.cb_cond_op
    put `"""' ") condvalue(" `"""'
    put main.ed_cond_value
    put `"""' ")"
    if main.ck_condition {
        put " condition"
    }
    stata hidden immediate
    call main.ed_preview.setvalue char _dta[hxtoolbox_preview]
    call program monitor_refresh
    }
END

PROGRAM run_monitored
BEGIN
    require main.ed_preview
    call program monitor_refresh
    call dialog_ready.setvalue "0"
    put "hxexecute, command(" `"""'
    put main.ed_preview
    put `"""' ")"
    stata hidden immediate
    call data_changed.setvalue char _dta[hxtoolbox_native_refresh]
    call program refresh_controls
    call main.cb_monitor_var.setvalue char _dta[hxtoolbox_monitor_var]
    call program refresh_monitor_display
    call dialog_ready.setvalue "1"
    if main.ck_auto_browser & data_changed.iseq("1") {
        call program workbench_refresh_browser
    }
END

PROGRAM monitor_browse
BEGIN
    call program monitor_refresh
    put "hxmonitor, action(browse)"
    stata hidden immediate
END

PROGRAM monitor_summary
BEGIN
    call program monitor_refresh
    put "hxmonitor, action(summary)"
    stata hidden immediate
END

PROGRAM monitor_graph
BEGIN
    call program monitor_refresh
    put "hxmonitor, action(graph)"
    stata hidden immediate
END

PROGRAM monitor_relation
BEGIN
    call program monitor_refresh
    put "hxmonitor, action(relation)"
    stata hidden immediate
END

PROGRAM preview_schema_legacy
BEGIN
    /*
       可见的“已选变量”框保持禁用，防止键盘录入；真正参与命令
       拼接的是同值的隐藏 EDIT。Stata 的 dialog 引擎可以稳定读取
       控件值，这也避免隐藏命令执行后 SCRIPT STRING 状态不同步。
    */
    call option_buffer.setvalue ""
    call main.ed_preview.setvalue ""
    call current_cmd.withvalue main.ed_preview.append "@"

    if schema_is_xtset.iseq("1") {
        if main.cb_panel {
            call main.ed_preview.append " "
            call main.cb_panel.withvalue main.ed_preview.append "@"
        }
        if main.cb_time {
            call main.ed_preview.append " "
            call main.cb_time.withvalue main.ed_preview.append "@"
        }
    }

    if schema_model_before.iseq("1") {
        if main.cb_model {
            call main.ed_preview.append " "
            if main.cb_model.iseq("两阶段最小二乘（2SLS）") {
                call main.ed_preview.append "2sls"
            }
            else if main.cb_model.iseq("有限信息极大似然（LIML）") {
                call main.ed_preview.append "liml"
            }
            else if main.cb_model.iseq("广义矩估计（GMM）") {
                call main.ed_preview.append "gmm"
            }
            else {
                call main.cb_model.withvalue main.ed_preview.append "@"
            }
        }
    }
    if schema_newvar.iseq("1") {
        if main.ed_newvar {
            call main.ed_preview.append " "
            call main.ed_newvar.withvalue main.ed_preview.append "@"
            if schema_expression.iseq("1") & schema_template.iseq("generate") {
                call main.ed_preview.append " = "
                call main.ed_expression.withvalue main.ed_preview.append "@"
            }
        }
    }
    if schema_dep.iseq("1") {
        if main.cb_dep {
            call main.ed_preview.append " "
            call main.cb_dep.withvalue main.ed_preview.append "@"
        }
    }
    if schema_template.iseq("replace") {
        if main.ed_expression {
            call main.ed_preview.append " = "
            call main.ed_expression.withvalue main.ed_preview.append "@"
        }
    }
    if schema_template.iseq("expression_body") {
        if main.ed_expression {
            call main.ed_preview.append " "
            call main.ed_expression.withvalue main.ed_preview.append "@"
        }
    }

    if schema_template.iseq("ttest") {
        call main.ed_preview.append " "
        call main.ed_vars_value.withvalue main.ed_preview.append "@"
        if main.cb_model.iseq("单样本（=数值）") | main.cb_model.iseq("配对比较") {
            call main.ed_preview.append " == "
            call main.ed_expression.withvalue main.ed_preview.append "@"
        }
    }
    else if schema_keepdrop_mode.iseq("1") {
        if main.cb_model.iseq("处理变量") {
            call main.ed_preview.append " "
            call main.ed_vars_value.withvalue main.ed_preview.append "@"
        }
    }
    else {
        if schema_vars.iseq("1") {
            call main.ed_preview.append " "
            call main.ed_vars_value.withvalue main.ed_preview.append "@"
        }
        if schema_template.iseq("generic") & schema_dep.iseq("0") & schema_vars.iseq("0") & schema_expression.iseq("0") {
            call main.ed_preview.append " "
            call main.ed_vars_value.withvalue main.ed_preview.append "@"
        }
    }

    if schema_iv.iseq("1") {
        if main.ed_endog_value {
            call main.ed_preview.append " ("
            call main.ed_endog_value.withvalue main.ed_preview.append "@"
            call main.ed_preview.append " = "
            call main.ed_inst_value.withvalue main.ed_preview.append "@"
            call main.ed_preview.append ")"
        }
    }
    if main.ed_special {
        call main.ed_preview.append " "
        call main.ed_special.withvalue main.ed_preview.append "@"
    }
    if schema_using.iseq("1") {
        if main.fi_using {
            call main.ed_preview.append " using "
            call main.fi_using.withvalue main.ed_preview.append "@"
        }
    }
    if schema_weight.iseq("1") {
        if main.cb_weight {
            call main.ed_preview.append " ["
            call main.cb_weight.withvalue main.ed_preview.append "@"
            call main.ed_preview.append "="
            call main.cb_weight_var.withvalue main.ed_preview.append "@"
            call main.ed_preview.append "]"
        }
    }
    if schema_template.iseq("replace") {
        if main.ck_condition & main.cb_cond_var & main.cb_cond_op & main.ed_cond_value {
            call main.ed_preview.append " if "
            call main.cb_cond_var.withvalue main.ed_preview.append "@"
            call main.ed_preview.append " "
            call main.cb_cond_op.withvalue main.ed_preview.append "@"
            call main.ed_preview.append " "
            call main.ed_cond_value.withvalue main.ed_preview.append "@"
        }
    }
    else if schema_if.iseq("1") {
        if schema_keepdrop_mode.iseq("1") {
            if main.cb_model.iseq("处理样本") {
                if main.ed_if {
                    call main.ed_preview.append " if "
                    call main.ed_if.withvalue main.ed_preview.append "@"
                }
            }
        }
        else {
            if main.ed_if {
                call main.ed_preview.append " if "
                call main.ed_if.withvalue main.ed_preview.append "@"
            }
        }
    }
    if schema_in.iseq("1") {
        if main.ed_in {
            call main.ed_preview.append " in "
            call main.ed_in.withvalue main.ed_preview.append "@"
        }
    }

    if schema_template.iseq("ttest") {
        if main.cb_model.iseq("分组比较") {
            call option_buffer.append " by("
            call main.ed_expression.withvalue option_buffer.append "@"
            call option_buffer.append ")"
        }
    }
    if schema_models & schema_model_before.iseq("0") {
        if schema_keepdrop_mode.iseq("0") & schema_winsor_mode.iseq("0") & schema_predict_mode.iseq("0") & schema_template.iseq("ttest") == 0 {
            if main.cb_model {
                call option_buffer.append " "
                if main.cb_model.iseq("固定效应（FE）") {
                    call option_buffer.append "fe"
                }
                else if main.cb_model.iseq("随机效应（RE）") {
                    call option_buffer.append "re"
                }
                else if main.cb_model.iseq("组间效应（Between）") {
                    call option_buffer.append "be"
                }
                else if main.cb_model.iseq("总体平均（PA）") {
                    call option_buffer.append "pa"
                }
                else {
                    call main.cb_model.withvalue option_buffer.append "@"
                }
            }
        }
    }
    if schema_winsor_mode.iseq("1") {
        if main.ed_expression {
            call option_buffer.append " cuts("
            call main.ed_expression.withvalue option_buffer.append "@"
            call option_buffer.append ")"
        }
        if main.cb_model.iseq("覆盖原变量") {
            call option_buffer.append " replace"
        }
        else {
            call option_buffer.append " suffix(_w)"
        }
    }
    if schema_predict_mode.iseq("1") {
        if main.cb_model.iseq("残差") {
            call option_buffer.append " residuals"
        }
        if main.cb_model.iseq("标准化残差") {
            call option_buffer.append " rstandard"
        }
    }
    if schema_template.iseq("margins") {
        if main.ed_expression {
            call option_buffer.append " "
            call main.ed_expression.withvalue option_buffer.append "@"
        }
    }
    if schema_absorb.iseq("1") {
        if main.ed_absorb_value {
            call option_buffer.append " absorb("
            call main.ed_absorb_value.withvalue option_buffer.append "@"
            call option_buffer.append ")"
        }
    }
    if schema_vce.iseq("1") {
        if main.cb_vce.iseq("robust") {
            call option_buffer.append " vce(robust)"
        }
        if main.cb_vce.iseq("cluster") {
            call option_buffer.append " vce(cluster "
            call main.cb_cluster.withvalue option_buffer.append "@"
            call option_buffer.append ")"
        }
    }
    if main.ed_options {
        call option_buffer.append " "
        call main.ed_options.withvalue option_buffer.append "@"
    }
    if option_buffer {
        call main.ed_preview.append ","
        call option_buffer.withvalue main.ed_preview.append "@"
    }
END

PROGRAM add_var
BEGIN
    put "hxpick, target(vars) action(add) value("
    put main.cb_var_pick
    put ")"
    stata hidden immediate
    call selected_vars.setvalue char _dta[hxtoolbox_pick_vars]
    call main.ed_vars.setvalue char _dta[hxtoolbox_pick_vars]
    call main.ed_vars_value.setvalue char _dta[hxtoolbox_pick_vars]
    call program preview_schema
END
