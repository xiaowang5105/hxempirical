/* hxselect.dlg - 左侧操作、右侧代码记录 */
VERSION 16.0
SYNCHRONOUS_ONLY

INCLUDE _std_large
POSITION . . 660 535
CANCEL can1, label("关闭")
INCLUDE levels_list

HELP hlp1, view("help hxselect")
RESET res1

SCRIPT PREINIT
BEGIN
    create STRING reg_CMD
    create STRING transform_CMD
    create STRING merge_CMD
    create DOUBLE model_count
    model_count.setvalue 1
END

SCRIPT POSTINIT
BEGIN
    program init_models
    program init_processing
    program refresh_variables
END

PROGRAM init_processing
BEGIN
    call merge.ed_bvalue.disable
END

PROGRAM init_models
BEGIN
    call model_count.setvalue 1
    call main.bu_remove_model.disable
    call main.bu_add_model.enable
    call main.vl_required.disable
    call main.vl_candidates.disable
    call main.vl_base1.disable
    call main.vl_base2.disable
    call main.vl_base3.disable
    call main.vl_base4.disable

    call main.cb_method2.hide
    call main.vn_y2.hide
    call main.vn_x2.hide
    call main.cb_sign2.hide
    call main.tx_base2.hide
    call main.vl_base2.hide
    call main.cb_base2_pick.hide
    call main.bu_base2_add.hide
    call main.bu_base2_clear.hide
    call main.tx_tail2.hide
    call main.ed_tail2.hide

    call main.cb_method3.hide
    call main.vn_y3.hide
    call main.vn_x3.hide
    call main.cb_sign3.hide
    call main.tx_base3.hide
    call main.vl_base3.hide
    call main.cb_base3_pick.hide
    call main.bu_base3_add.hide
    call main.bu_base3_clear.hide
    call main.tx_tail3.hide
    call main.ed_tail3.hide

    call main.cb_method4.hide
    call main.vn_y4.hide
    call main.vn_x4.hide
    call main.cb_sign4.hide
    call main.tx_base4.hide
    call main.vl_base4.hide
    call main.cb_base4_pick.hide
    call main.bu_base4_add.hide
    call main.bu_base4_clear.hide
    call main.tx_tail4.hide
    call main.ed_tail4.hide
END

DIALOG main, label("显著控制变量组合筛选器") tabtitle("显著组合")
BEGIN
    GROUPBOX gb_controls 10 10 640 90, label("控制变量")
    TEXT tx_required 25 35 50 ., label("必备")
    EDIT vl_required 75 35 330 ., nomemory label("已选必备控制变量")
    COMBOBOX cb_required_pick 410 35 150 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选必备变量")
    BUTTON bu_required_add 565 35 28 ., label("＋") onpush(program add_required)
    BUTTON bu_required_clear 598 35 42 ., label("清空") onpush(program clear_required)
    TEXT tx_candidates 25 70 50 ., label("候选")
    EDIT vl_candidates 75 70 330 ., nomemory label("已选候选控制变量")
    COMBOBOX cb_candidates_pick 410 70 150 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选候选变量")
    BUTTON bu_candidates_add 565 70 28 ., label("＋") onpush(program add_candidates)
    BUTTON bu_candidates_clear 598 70 42 ., label("清空") onpush(program clear_candidates)

    GROUPBOX gb_models 10 110 640 265, label("模型设置（至少1个，最多4个）")
    BUTTON bu_add_model 560 118 32 ., label("＋") onpush(program add_model)
    BUTTON bu_remove_model 598 118 32 ., label("－") onpush(program remove_model)
    TEXT hd_method 25 135 90 ., label("方法")
    TEXT hd_y 125 135 100 ., label("被解释变量Y")
    TEXT hd_x 235 135 100 ., label("核心X")
    TEXT hd_sign 345 135 100 ., label("方向")

    COMBOBOX cb_method1 25 155 90 ., dropdownlist contents(method_labels) ///
        values(method_values) default(regress)
    COMBOBOX vn_y1 125 155 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型1被解释变量")
    COMBOBOX vn_x1 235 155 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型1核心解释变量")
    COMBOBOX cb_sign1 345 155 100 ., dropdownlist contents(sign_labels) ///
        values(sign_values) default(any)
    TEXT tx_base1 25 182 60 ., label("基础变量")
    EDIT vl_base1 85 178 130 ., nomemory label("模型1已选基础变量")
    COMBOBOX cb_base1_pick 220 178 90 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选模型1基础变量")
    BUTTON bu_base1_add 315 178 28 ., label("＋") onpush(program add_base1)
    BUTTON bu_base1_clear 348 178 42 ., label("清空") onpush(program clear_base1)
    TEXT tx_tail1 400 182 45 ., label("选项")
    EDIT ed_tail1 445 178 185 ., label("样本与命令选项")

    COMBOBOX cb_method2 25 215 90 ., dropdownlist contents(method_labels) ///
        values(method_values) default(regress)
    COMBOBOX vn_y2 125 215 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型2被解释变量")
    COMBOBOX vn_x2 235 215 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型2核心解释变量")
    COMBOBOX cb_sign2 345 215 100 ., dropdownlist contents(sign_labels) ///
        values(sign_values) default(any)
    TEXT tx_base2 25 242 60 ., label("基础变量")
    EDIT vl_base2 85 238 130 ., nomemory label("模型2已选基础变量")
    COMBOBOX cb_base2_pick 220 238 90 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选模型2基础变量")
    BUTTON bu_base2_add 315 238 28 ., label("＋") onpush(program add_base2)
    BUTTON bu_base2_clear 348 238 42 ., label("清空") onpush(program clear_base2)
    TEXT tx_tail2 400 242 45 ., label("选项")
    EDIT ed_tail2 445 238 185 ., label("模型2样本与命令选项")

    COMBOBOX cb_method3 25 275 90 ., dropdownlist contents(method_labels) ///
        values(method_values) default(regress)
    COMBOBOX vn_y3 125 275 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型3被解释变量")
    COMBOBOX vn_x3 235 275 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型3核心解释变量")
    COMBOBOX cb_sign3 345 275 100 ., dropdownlist contents(sign_labels) ///
        values(sign_values) default(any)
    TEXT tx_base3 25 302 60 ., label("基础变量")
    EDIT vl_base3 85 298 130 ., nomemory label("模型3已选基础变量")
    COMBOBOX cb_base3_pick 220 298 90 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选模型3基础变量")
    BUTTON bu_base3_add 315 298 28 ., label("＋") onpush(program add_base3)
    BUTTON bu_base3_clear 348 298 42 ., label("清空") onpush(program clear_base3)
    TEXT tx_tail3 400 302 45 ., label("选项")
    EDIT ed_tail3 445 298 185 ., label("模型3样本与命令选项")

    COMBOBOX cb_method4 25 335 90 ., dropdownlist contents(method_labels) ///
        values(method_values) default(regress)
    COMBOBOX vn_y4 125 335 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型4被解释变量")
    COMBOBOX vn_x4 235 335 100 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("模型4核心解释变量")
    COMBOBOX cb_sign4 345 335 100 ., dropdownlist contents(sign_labels) ///
        values(sign_values) default(any)
    TEXT tx_base4 25 362 60 ., label("基础变量")
    EDIT vl_base4 85 358 130 ., nomemory label("模型4已选基础变量")
    COMBOBOX cb_base4_pick 220 358 90 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选模型4基础变量")
    BUTTON bu_base4_add 315 358 28 ., label("＋") onpush(program add_base4)
    BUTTON bu_base4_clear 348 358 42 ., label("清空") onpush(program clear_base4)
    TEXT tx_tail4 400 362 45 ., label("选项")
    EDIT ed_tail4 445 358 185 ., label("模型4样本与命令选项")

    GROUPBOX gb_rules 10 385 640 100, label("共同筛选规则")
    TEXT tx_pmax 25 410 55 ., label("显著性")
    COMBOBOX cb_pmax 80 405 125 ., dropdownlist contents(p_labels) ///
        values(p_values) default(0.10)
    TEXT tx_min 220 410 40 ., label("最少")
    SPINNER sp_min 260 405 55 ., min(0) max(15) default(0)
    TEXT tx_max 325 410 40 ., label("最多")
    SPINNER sp_max 365 405 55 ., min(0) max(15) default(15)
    TEXT tx_runs 435 410 70 ., label("回归上限")
    EDIT ed_runs 505 405 110 ., default("20000")
    TEXT tx_saving 25 450 55 ., label("结果")
    EDIT ed_saving 80 445 260 ., default("hxselect_results.dta")
    CHECKBOX ck_replace 355 445 100 ., label("覆盖文件")
    CHECKBOX ck_empty 465 445 80 ., label("含零控制")
    CHECKBOX ck_best 550 445 80 ., label("跑第一名")

    BUTTON bu_reg_run 490 495 140 ., label("运行显著组合") ///
        onpush(program regression_submit)
END

DIALOG merge, tabtitle("数据处理")
BEGIN
    GROUPBOX gb_transform 10 10 640 215, label("生成新变量（按 1 → 2 → 3 操作）")
    TEXT tx_step1 25 38 105 ., label("1. 想做什么")
    COMBOBOX cb_operation 130 33 205 ., dropdownlist contents(transform_labels) ///
        values(transform_values) default(ln) label("选择处理方法")
    TEXT tx_newvar 355 38 105 ., label("新变量叫什么")
    EDIT ed_newvar 465 33 165 ., nomemory label("填写新变量名")

    TEXT tx_step2 25 78 105 ., label("2. 选择原变量 A")
    COMBOBOX vn_var1 130 73 205 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选原变量 A")
    TEXT tx_replacevar 355 78 105 ., label("名字已存在时")
    CHECKBOX ck_replacevar 465 73 165 ., label("允许覆盖该变量")

    TEXT tx_step3 25 118 105 ., label("3. 第二项 B")
    COMBOBOX vn_var2 130 113 205 ., dropdownlist nomemory ///
        contents(char _dta[hxselect_numeric_vars]) label("点选另一个变量 B")
    BUTTON bu_usevar 355 113 82 ., label("B 选变量") onpush(program use_variable)
    BUTTON bu_usenumber 443 113 82 ., label("B 用数字") onpush(program use_constant)
    EDIT ed_bvalue 535 113 95 ., nomemory label("填写数字 B")

    TEXT tx_cutoff 25 158 105 ., label("缩尾比例")
    COMBOBOX cb_cutoff 130 153 100 ., dropdownlist contents(cutoff_labels) ///
        values(cutoff_values) default(1)
    TEXT tx_cutoff_note 240 158 290 ., label("仅“缩尾处理”使用；通常选择 1%")
    BUTTON bu_transform 535 153 95 30, label("生成变量") ///
        onpush(program transform_submit)

    TEXT tx_transform_tip 25 195 600 ., ///
        label("提示：只有加、减、乘、除需要 B；对数、标准化、缩尾等只选择 A。")

    GROUPBOX gb_merge 10 235 640 230, label("主表与副表合并")
    TEXT tx_master 25 263 90 ., label("1. 选择主表")
    FILE fi_master 120 258 510 ., defext(dta) label("浏览...")
    TEXT tx_using 25 303 90 ., label("2. 选择副表")
    FILE fi_using 120 298 510 ., defext(dta) label("浏览...")

    TEXT tx_keys 25 343 90 ., label("3. 关联变量")
    EDIT ed_keys 120 338 200 ., nomemory label("如 firmid year")
    TEXT tx_type 335 343 80 ., label("匹配方式")
    COMBOBOX cb_type 415 338 215 ., dropdownlist contents(merge_type_labels) ///
        values(merge_type_values) default("1:1")

    TEXT tx_keep 25 383 90 ., label("合并后保留")
    COMBOBOX cb_keep 120 378 200 ., dropdownlist contents(merge_keep_labels) ///
        values(merge_keep_values) default("master match using")
    TEXT tx_flag 335 383 80 ., label("合并标记名")
    EDIT ed_flag 415 378 215 ., default("_hxmerge")

    CHECKBOX ck_update 25 418 185 ., label("用副表补充主表缺失值")
    CHECKBOX ck_mergereplace 215 418 185 ., label("有冲突时使用副表值")
    CHECKBOX ck_force 405 418 105 ., label("强制转换类型")
    BUTTON bu_merge 520 413 110 30, label("开始合并") onpush(program merge_submit)

    TEXT tx_merge_tip 25 450 600 ., ///
        label("常用面板：企业—年份在两表都唯一时选 1:1；副表每个企业—年份唯一时选 m:1。")

END

LIST method_labels
BEGIN
    "OLS"
    "面板"
    "高维FE"
    "Logit"
    "Probit"
    "Poisson"
    "PPMLHDFE"
END
LIST method_values
BEGIN
    regress
    xtreg
    reghdfe
    logit
    probit
    poisson
    ppmlhdfe
END
LIST p_labels
BEGIN
    "10%"
    "5%"
    "1%"
END
LIST p_values
BEGIN
    0.10
    0.05
    0.01
END
LIST sign_labels
BEGIN
    "任意"
    "正"
    "负"
END
LIST sign_values
BEGIN
    any
    positive
    negative
END

LIST transform_labels
BEGIN
    "自然对数 ln(A)"
    "加 1 后取对数 ln(A+1)"
    "A + B（加法）"
    "A - B（减法）"
    "A × B（乘法）"
    "A ÷ B（除法/比例）"
    "A 的平方"
    "A 的平方根"
    "A 的绝对值"
    "标准化（均值 0、标准差 1）"
    "去均值（A 减去平均值）"
    "倒数 1/A"
    "滞后一期"
    "领先一期"
    "一阶差分"
    "增长率（百分比）"
    "双侧缩尾"
END
LIST transform_values
BEGIN
    ln
    ln1p
    add
    subtract
    multiply
    divide
    square
    sqrt
    abs
    zscore
    demean
    reciprocal
    lag
    lead
    difference
    growth
    winsor
END

LIST cutoff_labels
BEGIN
    "0.5%"
    "1%（常用）"
    "2%"
    "5%"
END
LIST cutoff_values
BEGIN
    0.5
    1
    2
    5
END

LIST merge_type_labels
BEGIN
    "1:1 两张表的关联变量都唯一"
    "m:1 主表可重复，副表必须唯一"
    "1:m 主表必须唯一，副表可重复"
END
LIST merge_type_values
BEGIN
    "1:1"
    "m:1"
    "1:m"
END

LIST merge_keep_labels
BEGIN
    "保留两张表的全部记录"
    "只保留匹配成功的记录"
    "保留主表全部和匹配记录"
    "保留副表全部和匹配记录"
END
LIST merge_keep_values
BEGIN
    "master match using"
    "match"
    "master match"
    "using match"
END

PROGRAM use_variable
BEGIN
    call merge.ed_bvalue.setvalue ""
    call merge.ed_bvalue.disable
    call merge.vn_var2.enable
END

PROGRAM use_constant
BEGIN
    call merge.vn_var2.setvalue ""
    call merge.vn_var2.disable
    call merge.ed_bvalue.enable
END

PROGRAM transform_submit
BEGIN
    require merge.cb_operation
    require merge.ed_newvar
    require merge.vn_var1
    put "hxtransform, generate("
    put merge.ed_newvar
    put ") operation("
    put merge.cb_operation
    put ") var1("
    put merge.vn_var1
    put ")"
    if merge.vn_var2 {
        put " var2("
        put merge.vn_var2
        put ")"
    }
    if merge.ed_bvalue {
        put " bvalue("
        put merge.ed_bvalue
        put ")"
    }
    put " cutoff("
    put merge.cb_cutoff
    put ")"
    if merge.ck_replacevar { put " replace" }
    stata
    program refresh_variables
END

PROGRAM merge_submit
BEGIN
    require merge.fi_master
    require merge.fi_using
    require merge.ed_keys
    require merge.ed_flag
    put "hxmerge, master(" `"""'
    put merge.fi_master
    put `"""' ") usingfile(" `"""'
    put merge.fi_using
    put `"""' ") keys("
    put merge.ed_keys
    put ") type("
    put merge.cb_type
    put ") keep("
    put merge.cb_keep
    put ") generate("
    put merge.ed_flag
    put ")"
    if merge.ck_update { put " update" }
    if merge.ck_mergereplace { put " replace" }
    if merge.ck_force { put " force" }
    stata
    program refresh_variables
END
PROGRAM add_required
BEGIN
    call main.cb_required_pick.withvalue main.vl_required.append " @"
END

PROGRAM clear_required
BEGIN
    call main.vl_required.setvalue ""
END

PROGRAM add_candidates
BEGIN
    call main.cb_candidates_pick.withvalue main.vl_candidates.append " @"
END

PROGRAM clear_candidates
BEGIN
    call main.vl_candidates.setvalue ""
END

PROGRAM add_base1
BEGIN
    call main.cb_base1_pick.withvalue main.vl_base1.append " @"
END

PROGRAM clear_base1
BEGIN
    call main.vl_base1.setvalue ""
END

PROGRAM add_base2
BEGIN
    call main.cb_base2_pick.withvalue main.vl_base2.append " @"
END

PROGRAM clear_base2
BEGIN
    call main.vl_base2.setvalue ""
END

PROGRAM add_base3
BEGIN
    call main.cb_base3_pick.withvalue main.vl_base3.append " @"
END

PROGRAM clear_base3
BEGIN
    call main.vl_base3.setvalue ""
END

PROGRAM add_base4
BEGIN
    call main.cb_base4_pick.withvalue main.vl_base4.append " @"
END

PROGRAM clear_base4
BEGIN
    call main.vl_base4.setvalue ""
END

PROGRAM add_model
BEGIN
    if model_count.iseq(1) {
        call main.cb_method2.show
        call main.vn_y2.show
        call main.vn_x2.show
        call main.cb_sign2.show
        call main.tx_base2.show
        call main.vl_base2.show
        call main.cb_base2_pick.show
        call main.bu_base2_add.show
        call main.bu_base2_clear.show
        call main.tx_tail2.show
        call main.ed_tail2.show
        call model_count.increment
        call main.bu_remove_model.enable
        exit
    }
    if model_count.iseq(2) {
        call main.cb_method3.show
        call main.vn_y3.show
        call main.vn_x3.show
        call main.cb_sign3.show
        call main.tx_base3.show
        call main.vl_base3.show
        call main.cb_base3_pick.show
        call main.bu_base3_add.show
        call main.bu_base3_clear.show
        call main.tx_tail3.show
        call main.ed_tail3.show
        call model_count.increment
        exit
    }
    if model_count.iseq(3) {
        call main.cb_method4.show
        call main.vn_y4.show
        call main.vn_x4.show
        call main.cb_sign4.show
        call main.tx_base4.show
        call main.vl_base4.show
        call main.cb_base4_pick.show
        call main.bu_base4_add.show
        call main.bu_base4_clear.show
        call main.tx_tail4.show
        call main.ed_tail4.show
        call model_count.increment
        call main.bu_add_model.disable
    }
END

PROGRAM remove_model
BEGIN
    if model_count.iseq(4) {
        call main.vn_y4.setvalue ""
        call main.vn_x4.setvalue ""
        call main.vl_base4.setvalue ""
        call main.ed_tail4.setvalue ""
        call main.cb_method4.hide
        call main.vn_y4.hide
        call main.vn_x4.hide
        call main.cb_sign4.hide
        call main.tx_base4.hide
        call main.vl_base4.hide
        call main.cb_base4_pick.hide
        call main.bu_base4_add.hide
        call main.bu_base4_clear.hide
        call main.tx_tail4.hide
        call main.ed_tail4.hide
        call model_count.decrement
        call main.bu_add_model.enable
        exit
    }
    if model_count.iseq(3) {
        call main.vn_y3.setvalue ""
        call main.vn_x3.setvalue ""
        call main.vl_base3.setvalue ""
        call main.ed_tail3.setvalue ""
        call main.cb_method3.hide
        call main.vn_y3.hide
        call main.vn_x3.hide
        call main.cb_sign3.hide
        call main.tx_base3.hide
        call main.vl_base3.hide
        call main.cb_base3_pick.hide
        call main.bu_base3_add.hide
        call main.bu_base3_clear.hide
        call main.tx_tail3.hide
        call main.ed_tail3.hide
        call model_count.decrement
        exit
    }
    if model_count.iseq(2) {
        call main.vn_y2.setvalue ""
        call main.vn_x2.setvalue ""
        call main.vl_base2.setvalue ""
        call main.ed_tail2.setvalue ""
        call main.cb_method2.hide
        call main.vn_y2.hide
        call main.vn_x2.hide
        call main.cb_sign2.hide
        call main.tx_base2.hide
        call main.vl_base2.hide
        call main.cb_base2_pick.hide
        call main.bu_base2_add.hide
        call main.bu_base2_clear.hide
        call main.tx_tail2.hide
        call main.ed_tail2.hide
        call model_count.decrement
        call main.bu_remove_model.disable
    }
END

PROGRAM regression_submit
BEGIN
    require main.vl_candidates
    require main.vn_y1
    require main.vn_x1
    call reg_CMD.setvalue "hxselect, candidates("
    call main.vl_candidates.withvalue reg_CMD.append "@"
    call reg_CMD.append ") model1("
    call main.cb_method1.withvalue reg_CMD.append "@"
    call main.vn_y1.withvalue reg_CMD.append " @"
    call main.vn_x1.withvalue reg_CMD.append " @"
    if main.vl_required { call main.vl_required.withvalue reg_CMD.append " @" }
    if main.vl_base1 { call main.vl_base1.withvalue reg_CMD.append " @" }
    call reg_CMD.append " {controls}"
    if main.ed_tail1 { call main.ed_tail1.withvalue reg_CMD.append " @" }
    call reg_CMD.append ") target1("
    call main.vn_x1.withvalue reg_CMD.append "@"
    call reg_CMD.append ") sign1("
    call main.cb_sign1.withvalue reg_CMD.append "@"
    call reg_CMD.append ")"

    if model_count.isgt(1) {
        require main.vn_y2
        require main.vn_x2
        call reg_CMD.append " model2("
        call main.cb_method2.withvalue reg_CMD.append "@"
        call main.vn_y2.withvalue reg_CMD.append " @"
        call main.vn_x2.withvalue reg_CMD.append " @"
        if main.vl_required { call main.vl_required.withvalue reg_CMD.append " @" }
        if main.vl_base2 { call main.vl_base2.withvalue reg_CMD.append " @" }
        call reg_CMD.append " {controls}"
        if main.ed_tail2 { call main.ed_tail2.withvalue reg_CMD.append " @" }
        call reg_CMD.append ") target2("
        call main.vn_x2.withvalue reg_CMD.append "@"
        call reg_CMD.append ") sign2("
        call main.cb_sign2.withvalue reg_CMD.append "@"
        call reg_CMD.append ")"
    }
    if model_count.isgt(2) {
        require main.vn_y3
        require main.vn_x3
        call reg_CMD.append " model3("
        call main.cb_method3.withvalue reg_CMD.append "@"
        call main.vn_y3.withvalue reg_CMD.append " @"
        call main.vn_x3.withvalue reg_CMD.append " @"
        if main.vl_required { call main.vl_required.withvalue reg_CMD.append " @" }
        if main.vl_base3 { call main.vl_base3.withvalue reg_CMD.append " @" }
        call reg_CMD.append " {controls}"
        if main.ed_tail3 { call main.ed_tail3.withvalue reg_CMD.append " @" }
        call reg_CMD.append ") target3("
        call main.vn_x3.withvalue reg_CMD.append "@"
        call reg_CMD.append ") sign3("
        call main.cb_sign3.withvalue reg_CMD.append "@"
        call reg_CMD.append ")"
    }
    if model_count.isgt(3) {
        require main.vn_y4
        require main.vn_x4
        call reg_CMD.append " model4("
        call main.cb_method4.withvalue reg_CMD.append "@"
        call main.vn_y4.withvalue reg_CMD.append " @"
        call main.vn_x4.withvalue reg_CMD.append " @"
        if main.vl_required { call main.vl_required.withvalue reg_CMD.append " @" }
        if main.vl_base4 { call main.vl_base4.withvalue reg_CMD.append " @" }
        call reg_CMD.append " {controls}"
        if main.ed_tail4 { call main.ed_tail4.withvalue reg_CMD.append " @" }
        call reg_CMD.append ") target4("
        call main.vn_x4.withvalue reg_CMD.append "@"
        call reg_CMD.append ") sign4("
        call main.cb_sign4.withvalue reg_CMD.append "@"
        call reg_CMD.append ")"
    }

    call reg_CMD.append " pmax("
    call main.cb_pmax.withvalue reg_CMD.append "@"
    call reg_CMD.append ") mincontrols("
    call main.sp_min.withvalue reg_CMD.append "@"
    call reg_CMD.append ") maxcontrols("
    call main.sp_max.withvalue reg_CMD.append "@"
    call reg_CMD.append ") maxruns("
    call main.ed_runs.withvalue reg_CMD.append "@"
    call reg_CMD.append ") saving("
    call main.ed_saving.withvalue reg_CMD.append "@"
    call reg_CMD.append ")"
    if main.ck_replace { call reg_CMD.append " replace" }
    if main.ck_empty { call reg_CMD.append " includeempty" }
    if main.ck_best { call reg_CMD.append " best" }

    put reg_CMD
    stata
END

PROGRAM refresh_variables
BEGIN
    put "hxrefresh"
    stata hidden immediate
    call main.cb_required_pick.repopulate
    call main.cb_candidates_pick.repopulate
    call main.vn_y1.repopulate
    call main.vn_x1.repopulate
    call main.cb_base1_pick.repopulate
    call main.vn_y2.repopulate
    call main.vn_x2.repopulate
    call main.cb_base2_pick.repopulate
    call main.vn_y3.repopulate
    call main.vn_x3.repopulate
    call main.cb_base3_pick.repopulate
    call main.vn_y4.repopulate
    call main.vn_x4.repopulate
    call main.cb_base4_pick.repopulate
    call merge.vn_var1.repopulate
    call merge.vn_var2.repopulate
END
